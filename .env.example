# The contact form's mail server. Names only — the values go into Coolify as
# runtime variables, or into a local .env (ignored by git) for testing.
#
# Google Workspace: smtp.gmail.com on port 465, signed in as the mailbox that
# sends (info@sanktum.de) with an app password for that account.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional. Both default to info@sanktum.de (src/content/company.ts).
SMTP_FROM=
CONTACT_TO=
