---
/**
 * Footer. Imprint and privacy only — the capital section sits directly above,
 * so a link down to it here would point at what the reader just read.
 */
import Wordmark from './Wordmark.astro';
import { DEFAULT_LANG, dictionaries } from '../content/copy';

const t = dictionaries[DEFAULT_LANG];
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  {/* The mark carries the name, so the line beside it is only the year —
      echoing the header, where the same mark sits next to the file reference. */}
  <span class="footer__mark">
    <Wordmark height={20} />
    <span>© {year}</span>
  </span>
  {/* Real pages, so the imprint is reachable without JavaScript and from any
      link to it. The privacy policy has to grow with the contact form and the
      booking — see src/components/legal/Datenschutz.astro. */}
  <span class="footer__links">
    <a href="/impressum" data-i18n="imprint">{t.imprint}</a>
    <a href="/datenschutz" data-i18n="privacy">{t.privacy}</a>
  </span>
</footer>

<style>
  .footer {
    background: var(--dark);
    border-top: 1px solid var(--rule-dark);
    padding: 26px var(--gutter) 54px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-dark-2);
  }

  .footer__mark {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    /* A shade brighter than the footer text: the mark reads as the mark, the
       small print stays small print. */
    color: #b6bcbf;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer a {
    color: var(--muted-dark-2);
  }

  .footer a:hover {
    color: var(--ocker);
  }
</style>
