---
/**
 * ⑤ C-01 Nächster Schritt — the 30-minute assessment, the form, and the four
 * people carrying the mandate.
 *
 * The form posts to /api/kontakt, which mails the enquiry to the team and a
 * fixed confirmation to the sender. Without JavaScript that is all there is:
 * the browser checks the required fields, the server answers with a page
 * (/kontakt/danke/ or /kontakt/fehler/). src/scripts/contact.ts improves on
 * it — checks here first, sends with fetch, and puts the answer where the form
 * was. The field limits are the server's (src/server/enquiry.ts).
 *
 * It must stay a POST. The form once had neither `method` nor `action`, and a
 * click sent every field as a GET query to the page's own address — name,
 * company, email and the project itself into the address bar, the browser
 * history and the host's request log.
 */
import SectionRules from './SectionRules.astro';
import CroppedImage from './CroppedImage.astro';
import viktorFink from '../assets/portrait-viktor-fink.webp';
import dennisArians from '../assets/portrait-dennis-arians.webp';
import erikEckert from '../assets/portrait-erik-eckert.webp';
import holgerWeller from '../assets/portrait-holger-weller.webp';
import { dictionaries, langFrom } from '../content/copy';
import { COMPANY } from '../content/company';
import { LIMITS } from '../server/enquiry';

const lang = langFrom(Astro.currentLocale);
const t = dictionaries[lang];

/**
 * Portraits, with the framing the design tool stored for each one
 * (.image-slots.state.json). Viktor Fink's shot is pushed in and down so the
 * 4:5 frame sits on the face rather than the ceiling.
 */
const portraits = {
  viktorFink: {
    src: viktorFink,
    view: { s: 1.3655015625, x: 0.9371875, y: 20.742375 },
  },
  dennisArians: {
    src: dennisArians,
    view: { s: 1, x: 0, y: 0 },
  },
  // These two were delivered as ordinary photographs and cropped to 4:5 on the
  // way in, so there is nothing left for the view to do. Erik Eckert's was framed to
  // match the two above: head a little over half the height, a hand's width of
  // air above it.
  erikEckert: {
    src: erikEckert,
    view: { s: 1, x: 0, y: 0 },
  },
  // TODO(bild): 205×256 is all the supplied file had. The slot wants 400×500 to
  // stay sharp on a retina screen, and the crop is tighter than the other three
  // because there was no room to pull back. Replace when the original turns up.
  holgerWeller: {
    src: holgerWeller,
    view: { s: 1, x: 0, y: 0 },
  },
} as const;

const fields = [
  { key: 'fName', name: 'name', type: 'text', autocomplete: 'name' },
  { key: 'fCompany', name: 'company', type: 'text', autocomplete: 'organization' },
  { key: 'fMail', name: 'email', type: 'email', autocomplete: 'email' },
] as const;
---

<section id="kontakt" class="section section--dark contact on-dark">
  <SectionRules />
  <div class="section__inner">
    <div class="section__head">
      <span class="marker marker--invert" data-marker>
        <span class="marker__ref">{t.ref4}</span>
        <span>{t.nav4}</span>
      </span>
    </div>

    <div class="contact__grid">
      <div>
        <h2 class="h2 contact__title">{t.s5Title}</h2>
        <p class="contact__lead">{t.s5Lead}</p>
        <p class="contact__scarcity">{t.s5Scarcity}</p>
        <div class="contact__reach">
          <div>{t.addr2}</div>
          <div><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></div>
        </div>
      </div>

      <div class="form-slot">
        <form class="form" method="post" action="/api/kontakt" data-contact-form>
          {/* The page's language, so the confirmation and the answer page
              come in it too. */}
          <input type="hidden" name="lang" value={lang} />
          {
            fields.map((f) => (
              <label>
                <span class="form__label">{t[f.key]}</span>
                <input
                  type={f.type}
                  name={f.name}
                  autocomplete={f.autocomplete}
                  maxlength={LIMITS[f.name]}
                  required
                />
              </label>
            ))
          }
          <label>
            <span class="form__label">{t.fMsg}</span>
            <textarea name="message" rows="3" maxlength={LIMITS.message}></textarea>
          </label>

          {/* For bots only: off screen, out of the tab order, hidden from
              screen readers. Named after nothing the form really asks for —
              "company" is a real field here. */}
          <div class="form__trap" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="form__foot">
            <button type="submit">{t.fSend}</button>
            {/* Always in the page, empty until there is something to say: a
                live region has to exist before it changes to be announced. */}
            <p class="form__status" role="status" data-contact-status></p>
            <p class="form__privacy">
              {t.fPrivacy}
              <a href="/datenschutz" data-legal-open="datenschutz">{t.fPrivacyLink}</a>.
            </p>
          </div>
        </form>

        <div class="form-done" data-contact-done tabindex="-1" hidden>
          <h3 class="form-done__title">{t.fDoneTitle}</h3>
          <p class="form-done__body">{t.fDoneBody}</p>
        </div>
      </div>
    </div>

    <div class:list={['people', t.people.length >= 4 && 'people--four']} data-reveal>
      {
        t.people.map((p) => (
          <div class="people__person">
            {p.photo ? (
              <CroppedImage
                src={portraits[p.photo].src}
                view={portraits[p.photo].view}
                alt={p.name}
                aspect={4 / 5}
                widths={[200, 400]}
                sizes="200px"
                maxWidth={200}
              />
            ) : (
              /* An empty frame, not a stand-in face. Same 4:5 box, so the row
                 keeps its rhythm while the seat is visibly still open. */
              <div class="people__frame">
                <span>{t.photoPending}</span>
              </div>
            )}
            <h3 class="people__name">
              {p.name}
            </h3>
            <div class="people__role">
              {p.role}
            </div>
            <p class="people__bio">
              {p.bio}
            </p>
            {p.mail && (
              <div class="people__reach">
                {/* Telefonnummern ausgeblendet. Stehen weiter als phone in copy.ts. */}
                {/* <div>{p.phone}</div> */}
                <div>
                  <a href={`mailto:${p.mail}`}>{p.mail}</a>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 96px;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(330px, 100%), 1fr));
    gap: 48px 64px;
    margin-bottom: 80px;
  }

  .contact__title {
    margin-bottom: 20px;
    max-width: 18em;
  }

  .contact__lead {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--muted-dark);
    margin: 0 0 24px;
    max-width: 28em;
  }

  .contact__scarcity {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ocker);
    margin: 0 0 28px;
  }

  .contact__reach {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted-dark);
    line-height: 2.1;
    border-top: 1px solid var(--rule-dark);
    padding-top: 18px;
  }

  .contact__reach a {
    color: var(--ocker);
  }

  .contact__reach a:hover {
    color: #fff;
  }

  /* ── Form ────────────────────────────────────────────────────────────── */

  .form {
    position: relative;
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .form label {
    display: grid;
    gap: 8px;
  }

  .form__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dark-2);
  }

  .form input,
  .form textarea {
    background: var(--dark-field);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 14px 18px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--paper);
    border-radius: 0;
  }

  .form textarea {
    resize: vertical;
  }

  /* Safari on iOS zooms the page in when a focused field's text is smaller than
     16px, and never zooms back out. One pixel of type buys a form that does not
     throw the layout around under the reader's thumb. */
  @media (pointer: coarse) {
    .form input,
    .form textarea {
      font-size: 16px;
    }
  }

  .form input:focus,
  .form textarea:focus {
    border-color: var(--ocker);
    outline: none;
  }

  /* Keyboard users still get a visible ring; the border alone is too quiet. */
  .form input:focus-visible,
  .form textarea:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }

  .form button {
    justify-self: start;
    background: var(--paper);
    color: var(--ink);
    border: 0;
    padding: 15px 30px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .form button:not([aria-disabled='true']):hover {
    background: var(--ocker);
    color: #fff;
  }

  /* While sending. aria-disabled rather than disabled: a disabled button drops
     the focus of whoever just pressed it. */
  .form button[aria-disabled='true'] {
    cursor: progress;
    opacity: 0.6;
  }

  /* Invalid fields take the accent the form already uses for focus; the message
     under the field says what is wrong. */
  .form input[aria-invalid='true'],
  .form textarea[aria-invalid='true'] {
    border-color: var(--ocker);
  }

  .form :global(.form__error) {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ocker);
  }

  .form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__foot {
    display: grid;
    justify-items: start;
  }

  .form__status {
    margin: 0;
    max-width: 30em;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted-dark);
  }

  .form__status:not(:empty) {
    margin-top: 14px;
  }

  .form__status.is-error {
    padding-left: 12px;
    border-left: 2px solid var(--ocker);
    color: var(--paper);
  }

  .form__privacy {
    margin: 14px 0 0;
    max-width: 30em;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted-dark-2);
  }

  .form__status :global(a),
  .form__privacy a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 3px;
  }

  .form__status :global(a:hover),
  .form__privacy a:hover {
    color: #fff;
    text-decoration-color: currentColor;
  }

  /* What the form becomes once the enquiry is through. Focused when it
     appears, so a screen reader reads it and the keyboard starts from here. */
  .form-done {
    border-top: 1px solid var(--rule-dark);
    padding-top: 22px;
  }

  .form-done__title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .form-done__body {
    margin: 0;
    max-width: 28em;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted-dark);
  }

  /* ── People ──────────────────────────────────────────────────────────── */

  /* Column counts are stated rather than left to auto-fit. With four people
     auto-fit lands on three across for a wide band of widths, which orphans the
     fourth on a row of its own next to a column of empty black. Going 1 → 2 → 4
     keeps the rows full at every size.

     The breakpoints are the widths at which the tracks actually fit: the
     section is 5% gutter on each side, so the inner measure is 0.9vw, and four
     200px portraits with three 48px gaps need 944px of it. */
  .people {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px 48px;
    max-width: 980px;
  }

  @media (min-width: 560px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Four across only when there are four to show. With two people the wider
     two-up measure is the approved layout, and squeezing them into the outer
     half of a four-track grid would leave the row looking half-finished. */
  @media (min-width: 1060px) {
    .people--four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* A seat with no portrait yet: the same frame, empty. Only the picture is
     held back — the card itself is not dimmed. A row where two people are a
     shade quieter than the other two reads as a ranking, not as work in
     progress, which is the wrong thing to say about the people on it. */
  .people__frame {
    aspect-ratio: 4 / 5;
    max-width: 200px;
    display: grid;
    place-items: center;
    background: var(--dark-well);
    border: 1px solid var(--rule-dark);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dark-2);
  }

  /* The four focus lines run to different lengths, which left the four contact
     blocks sitting at four different heights — noise on a page that otherwise
     keeps everything on a rule. The cards stretch to the tallest in their row,
     so pushing the contact block to the bottom puts the numbers back on one
     line across the row. */
  .people__person {
    display: flex;
    flex-direction: column;
  }

  .people__reach {
    margin-top: auto;
  }

  .people__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 18px 0 8px;
  }

  .people__role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ocker);
    margin-bottom: 12px;
  }

  .people__bio {
    font-size: 14.5px;
    line-height: 1.66;
    color: var(--muted-dark);
    margin: 0 0 14px;
  }

  .people__reach {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-dark-2);
    line-height: 1.9;
  }

  .people__reach a {
    color: #d8dcde;
  }

  .people__reach a:hover {
    color: #fff;
  }
</style>
