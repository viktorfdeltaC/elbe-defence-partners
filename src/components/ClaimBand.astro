---
/**
 * The full-bleed ocker statement between A-01 and A-02.
 *
 * It is the page's single exclamation mark, and deliberately the only one:
 * ocker is a code here (file references, lead figures), so a second ocker field
 * would turn the signal into a habit and neither would carry.
 *
 * It lives at the top level of the page rather than inside a section, so it
 * spans the viewport without having to negate a section's gutter.
 */
import { DEFAULT_LANG, dictionaries, type Copy } from '../content/copy';

interface Props {
  /** Key into the copy dictionaries. */
  textKey: keyof Copy;
}

const { textKey } = Astro.props;
const t = dictionaries[DEFAULT_LANG];
const text = t[textKey];
---

<div class="claim">
  <p data-i18n={textKey}>{text}</p>
</div>

<style>
  .claim {
    position: relative;
    padding: 24px var(--gutter);
    background: var(--ocker);
    color: var(--ink);
  }

  .claim p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.9vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .claim {
      padding-block: 20px;
      /* Matches the inner padding the sections get on a phone so the statement
         starts on the same left edge as the copy above and below it. */
      padding-inline: calc(var(--gutter) + 12px);
    }

    .claim p {
      font-size: 19px;
    }
  }
</style>
