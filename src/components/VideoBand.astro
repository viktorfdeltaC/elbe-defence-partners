---
/**
 * The atmosphere band between the services and the contact section.
 *
 * A plain autoplaying video: muted, inline, no loop, no controls, no script.
 * Muted + playsinline + autoplay is the combination browsers are built to
 * allow, and a video without `loop` stops on its last frame by itself — which
 * is exactly what the band is meant to do.
 *
 * Everything that used to sit around this — a script that decided when to call
 * play(), a still image swapped in on failure, a WebM offered first to save a
 * megabyte — is gone. Each of those was an attempt to be clever about a case
 * the browser already handles, and each of them is what broke it.
 *
 * H.264 only. It is the one video codec every browser has supported for over a
 * decade. The poster is the clip's first frame, so if a browser does refuse to
 * play, the band still shows the right picture instead of a black rectangle.
 */
---

<div class="videoband" aria-hidden="true">
  <video
    src="/media/band.mp4"
    poster="/media/band-poster.webp"
    autoplay
    muted
    playsinline
    preload="auto"
    tabindex="-1"
    disablepictureinpicture>
  </video>
  <span class="videoband__scrim"></span>
</div>

<style>
  .videoband {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 8;
    background: var(--dark-well);
    overflow: hidden;
  }

  .videoband video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .videoband__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(12, 14, 15, 0.42) 0%,
      rgba(12, 14, 15, 0.1) 45%,
      rgba(12, 14, 15, 0.5) 100%
    );
  }

  @media (max-width: 640px) {
    /* 21:8 collapses to a 149px sliver on a phone. */
    .videoband {
      aspect-ratio: 16 / 9;
    }
  }
</style>
