---
/**
 * The atmosphere band between the services and the contact section.
 *
 * It plays once, when the reader reaches it, and then holds its last frame —
 * not a loop. The clip brightens from almost black to a fully drawn site plan,
 * so the final frame is the strongest thing in it and stands on its own.
 *
 * The still is a real image rather than a paused <video>, for two reasons: a
 * paused video invites the browser to draw a play button over it, and the same
 * image is what the band falls back to whenever the clip does not run at all —
 * autoplay refused, or prefers-reduced-motion. The reader never meets an empty
 * black rectangle with a play control in the middle of it.
 *
 * Silent, decorative, hidden from assistive technology. The sound is forced off
 * in markup and again in script.
 */
---

<div class="videoband" aria-hidden="true" data-imgreveal>
  <video
    data-bandvideo
    poster="/media/band-poster.webp"
    muted
    playsinline
    preload="none"
    tabindex="-1"
    disablepictureinpicture>
    <source src="/media/band.webm" type="video/webm" />
    <source src="/media/band.mp4" type="video/mp4" />
  </video>
  <img class="videoband__still" data-bandstill src="/media/band-last.webp" alt="" hidden />
  <span class="videoband__scrim"></span>
</div>

<style>
  .videoband {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 8;
    background: var(--dark-well);
    overflow: hidden;
  }

  .videoband video,
  .videoband__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .videoband__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(12, 14, 15, 0.42) 0%,
      rgba(12, 14, 15, 0.1) 45%,
      rgba(12, 14, 15, 0.5) 100%
    );
  }

  @media (max-width: 640px) {
    /* 21:8 collapses to a 149px sliver on a phone. */
    .videoband {
      aspect-ratio: 16 / 9;
    }
  }
</style>
