---
/**
 * The frame for the two legal pages, /impressum and /datenschutz.
 *
 * They exist as pages so the texts are reachable without JavaScript and can be
 * linked to directly — an imprint has to be "unmittelbar erreichbar und ständig
 * verfügbar". On the one-pager the same components open as dialogs instead
 * (src/components/legal/LegalDialog.astro); here they are plain documents.
 *
 * One paper section in the page's own chrome — hairline rules, the black
 * marker with the file reference — under a slim black bar that leads back. The
 * page script runs here too, for the language switch and the rules' entry.
 */
import Base from './Base.astro';
import SectionRules from '../components/SectionRules.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Wordmark from '../components/Wordmark.astro';
import { DEFAULT_LANG, dictionaries, type TextKey } from '../content/copy';

interface Props {
  /** <title> of the page. */
  titleKey: TextKey;
  /** Visible heading of the page. */
  headingKey: TextKey;
}

const { titleKey, headingKey } = Astro.props;
const t = dictionaries[DEFAULT_LANG];
---

<Base titleKey={titleKey}>
  <header class="legal-bar on-dark">
    <a class="legal-bar__mark" href="/">
      <Wordmark height={24} />
    </a>
    <div class="legal-bar__nav">
      <a href="/" data-i18n="legalBack">{t.legalBack}</a>
      <span class="legal-bar__lang">
        <button type="button" data-lang="de" aria-pressed="true">DE</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </span>
    </div>
  </header>

  <main class="section legal-page">
    <SectionRules />
    <div class="section__inner">
      <span class="marker marker--static" data-marker>
        <span class="marker__ref">{t.docRef}</span>
        <span data-i18n="legalLabel">{t.legalLabel}</span>
      </span>
      <h1 class="h2 legal-page__title" data-i18n={headingKey}>{t[headingKey]}</h1>
      <slot />
    </div>
  </main>

  <SiteFooter />
</Base>

<script>
  import '../scripts/page';
</script>

<style>
  .legal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    padding: 20px var(--gutter);
    background: var(--dark);
    color: #fff;
  }

  .legal-bar__mark {
    color: #fff;
  }

  .legal-bar__mark:hover {
    color: #fff;
  }

  .legal-bar__nav {
    display: flex;
    align-items: center;
    gap: 10px 22px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .legal-bar__nav a {
    color: rgba(255, 255, 255, 0.78);
    white-space: nowrap;
  }

  .legal-bar__nav a:hover {
    color: #fff;
  }

  /* The switch from the hero, at the same size. */
  .legal-bar__lang {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legal-bar__lang button {
    background: none;
    border: 0;
    padding: 2px 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid transparent;
  }

  .legal-bar__lang button[aria-pressed='true'] {
    color: #fff;
    border-bottom-color: #fff;
  }

  @media (pointer: coarse) {
    .legal-bar__nav a,
    .legal-bar__lang button {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  /* A document, not a chapter of an argument: less air above it than the
     one-pager's sections take. */
  .legal-page {
    padding-top: 72px;
  }

  .legal-page__title {
    margin-bottom: 40px;
  }
</style>
