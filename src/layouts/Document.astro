---
/**
 * The frame for every page that is not the one-pager: the two legal texts
 * (/impressum/, /datenschutz/), the contact form's answers for visitors
 * without JavaScript (/kontakt/danke/, /kontakt/fehler/) and the Lagezentrum
 * — each with its English twin under /en/.
 *
 * The legal texts exist as pages so they are reachable without JavaScript and
 * can be linked to directly — an imprint has to be "unmittelbar erreichbar und
 * ständig verfügbar". On the one-pager the same components open as dialogs
 * instead (src/components/legal/LegalDialog.astro).
 *
 * One paper section in the page's own chrome — hairline rules, the black
 * marker with a file reference — under a slim black bar that leads back. The
 * language switch is two links to this page's twins, as in the hero.
 */
import Base from './Base.astro';
import SectionRules from '../components/SectionRules.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Wordmark from '../components/Wordmark.astro';
import { dictionaries, langFrom, pathIn, type TextKey } from '../content/copy';

interface Props {
  /** <title> of the page, as a dictionary key or as text (see Base.astro). */
  titleKey?: TextKey;
  title?: string;
  description?: string;
  /**
   * Visible heading of the page, with the marker above it. Left out, the page
   * brings its own heading in the slot — a Lagezentrum post does.
   */
  headingKey?: TextKey;
  /**
   * The marker above the heading: the document number and "Rechtliches" for
   * the legal texts, C-01 and "Nächster Schritt" for the contact form's pages.
   */
  refKey?: TextKey;
  labelKey?: TextKey;
  /** See Base.astro. */
  indexable?: boolean;
}

const { titleKey, title, description, headingKey, refKey = 'docRef', labelKey = 'legalLabel', indexable } = Astro.props;
const lang = langFrom(Astro.currentLocale);
const t = dictionaries[lang];
const home = pathIn(lang, '/');
---

<Base titleKey={titleKey} title={title} description={description} indexable={indexable}>
  <header class="legal-bar on-dark">
    <a class="legal-bar__mark" href={home}>
      <Wordmark height={24} />
    </a>
    <div class="legal-bar__nav">
      <a href={home}>{t.legalBack}</a>
      <span class="legal-bar__lang">
        <a href={pathIn('de', Astro.url.pathname)} aria-current={lang === 'de' ? 'page' : undefined}>DE</a>
        <a href={pathIn('en', Astro.url.pathname)} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </span>
    </div>
  </header>

  <main class="section legal-page">
    <SectionRules />
    <div class="section__inner">
      {
        headingKey && (
          <>
            <span class="marker marker--static" data-marker>
              <span class="marker__ref">{t[refKey]}</span>
              <span>{t[labelKey]}</span>
            </span>
            <h1 class="h2 legal-page__title">{t[headingKey]}</h1>
          </>
        )
      }
      <slot />
    </div>
  </main>

  <SiteFooter />
</Base>

<script>
  import '../scripts/page';
</script>

<style>
  .legal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    padding: 20px var(--gutter);
    background: var(--dark);
    color: #fff;
  }

  .legal-bar__mark {
    color: #fff;
  }

  .legal-bar__mark:hover {
    color: #fff;
  }

  .legal-bar__nav {
    display: flex;
    align-items: center;
    gap: 10px 22px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .legal-bar__nav a {
    color: rgba(255, 255, 255, 0.78);
    white-space: nowrap;
  }

  .legal-bar__nav a:hover {
    color: #fff;
  }

  /* The switch from the hero: two links, the current language underlined. */
  .legal-bar__lang {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legal-bar__lang a {
    padding: 2px 0;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid transparent;
  }

  .legal-bar__lang a[aria-current] {
    color: #fff;
    border-bottom-color: #fff;
  }

  @media (pointer: coarse) {
    .legal-bar__nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  /* The footer sits at the bottom of the window even when the page is short —
     the contact form's answers are two lines — instead of ending halfway down
     with bare paper beneath it. */
  :global(body) {
    display: flex;
    flex-direction: column;
  }

  /* A document, not a chapter of an argument: less air above it than the
     one-pager's sections take. */
  .legal-page {
    flex: 1 0 auto;
    padding-top: 72px;
  }

  .legal-page__title {
    margin-bottom: 40px;
  }
</style>
